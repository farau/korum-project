# Create a WalletConnect project ID for production.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Must match the public origin configured for the wallet connection project.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate with: openssl rand -hex 32
KORUM_SESSION_SECRET=replace_with_at_least_32_random_bytes

# Server-only PostgreSQL connection URL provided by Railway.
DATABASE_URL=postgresql://user:password@host:5432/database
