# Create a WalletConnect project ID for production.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Must match the public origin configured for the wallet connection project.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Build-time network selector. Use testnet locally/staging and mainnet in production.
NEXT_PUBLIC_KORUM_NETWORK=testnet

# Generate with: openssl rand -hex 32
KORUM_SESSION_SECRET=replace_with_at_least_32_random_bytes

# Server-only PostgreSQL connection URL provided by Railway.
DATABASE_URL=postgresql://user:password@host:5432/database

# Server-only Alchemy key used for ETH/USD quotes and the testnet RPC fallback.
ALCHEMY_API_KEY=your_alchemy_api_key

# Optional server-only full Alchemy endpoint override. Required for mainnet until
# its endpoint is configured here; never prefix this variable with NEXT_PUBLIC_.
KORUM_ALCHEMY_RPC_URL=

# Optional shared Redis cache. On Railway, reference the private Redis service:
# REDIS_URL=${{Redis.REDIS_URL}}
REDIS_URL=

# Read-only RPC fallback budget per client IP and window. Redis shares the
# counter across web replicas; an in-process limiter is used when Redis is absent.
KORUM_RPC_RATE_LIMIT=300
KORUM_RPC_RATE_WINDOW_SECONDS=60

# Server-only shared bearer token for Goldsky httpauth webhook delivery.
# Generate at least 32 random bytes. Configure the same token in Goldsky.
KORUM_GOLDSKY_WEBHOOK_SECRET=
